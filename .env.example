# Copy to .env.local and fill in. Both blocks are OPTIONAL — the site builds and runs without
# either, it just degrades honestly.

# Contribution calendar. Needs only the `read:user` scope.
#
# The calendar is not in GitHub's REST API; it exists only in GraphQL, and that endpoint
# requires auth even for public data. Without this the Contributions card renders an empty
# state instead of a skeleton that never resolves.
GITHUB_TOKEN=

# Upstash Redis, over its REST API. Backs the notes wall, the typing leaderboard and the
# deep-space find counter.
#
# Called with plain fetch and no SDK, so the project keeps its "no runtime dependencies beyond
# Next and React" rule. Without these, lib/store.ts falls back to an in-memory store and logs
# one warning — fine for local dev, useless in production, where each instance would have its
# own copy and nothing would persist.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
