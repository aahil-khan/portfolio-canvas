# Copy to .env.local and fill in. Both blocks are OPTIONAL — the site builds and runs without
# either, it just degrades honestly.

# Contribution calendar. Needs only the `read:user` scope.
#
# The calendar is not in GitHub's REST API; it exists only in GraphQL, and that endpoint
# requires auth even for public data. Without this the Contributions card renders an empty
# state instead of a skeleton that never resolves.
GITHUB_TOKEN=

# Upstash Redis, over its REST API. Backs the notes wall, the typing leaderboard, the
# deep-space find counter and the visitor stats.
#
# Called with plain fetch and no SDK, so the project keeps its "no runtime dependencies beyond
# Next and React" rule. Without these, lib/store.ts falls back to an in-memory store and logs
# one warning — fine for local dev, useless in production, where each instance would have its
# own copy and nothing would persist.
#
# Local dev and preview deploys write visitor counts under `canvas:vis:dev:*` rather than
# `canvas:vis:*`, so pointing this at the production database does not inflate the live numbers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Unlocks /stats — which cards people open, and where they arrived from.
#
# Any long random string. Without it /stats 404s rather than defaulting open, so forgetting to
# set this fails closed. The page is also disallowed in robots.txt and kept out of the sitemap.
STATS_TOKEN=

# The content editor at /edit. All five, or /edit and /api/edit/* 404 (fails closed).
#
# Create a GitHub App at https://github.com/settings/apps/new with:
#   GitHub App name            anything, e.g. "portfolio-canvas editor"
#   Homepage URL               https://<your site>
#   Callback URL               https://<your site>/api/edit/auth/callback
#   Expire user authorization tokens   ✓ (on — tokens live 8 hours)
#   Request user authorization (OAuth) during installation   leave off
#   Webhook                    Active: OFF (not used)
#   Repository permissions     Contents: Read and write   — nothing else
#   Where can it be installed  Only on this account
# Then: "Generate a new client secret", and "Install App" → Only select repositories →
# portfolio-canvas.
EDIT_GITHUB_APP_CLIENT_ID=
EDIT_GITHUB_APP_CLIENT_SECRET=
# Seals the session cookie. At least 32 characters: `openssl rand -base64 48`
EDIT_SESSION_SECRET=
# Your numeric GitHub user id (not your username): `curl -s https://api.github.com/users/<you> | grep '"id"'`
EDIT_ALLOWED_USER_ID=
# The site's public origin, no trailing slash. Must be https (localhost excepted).
EDIT_ORIGIN=

# Local only: `EDIT_DEV_FAKE=1 npm run dev` → a signed-in editor over an in-memory copy of this
# checkout, no GitHub App needed. Ignored when NODE_ENV=production.
# EDIT_DEV_FAKE=1
