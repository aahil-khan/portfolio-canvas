{
  "name": "portfolio-canvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/shot.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run content:check && node scripts/check-logos.mjs && npm run check:contrast",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "node --experimental-strip-types --no-warnings --test 'lib/**/*.test.ts' 'content/**/*.test.ts'",
    "content:check": "node --experimental-strip-types --no-warnings scripts/check-content.ts",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:lab": "node --experimental-strip-types --no-warnings scripts/check-lab.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@gsap/react": "^2.1.2",
    "feed": "6.0.0",
    "gsap": "^3.15.0",
    "hast-util-to-jsx-runtime": "2.3.7",
    "lenis": "1.3.26",
    "mdast-util-gfm-autolink-literal": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-table": "2.0.1",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "motion": "14.11.1",
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-directive": "4.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "shiki": "4.6.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "open-graph-scraper": "6.13.0",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
